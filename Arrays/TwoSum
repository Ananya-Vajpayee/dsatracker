#Brute force
class Solution:
    def twoSum(self, arr, target):
        n=len(arr)
        for i in range(n):
            for j in range(i+1, n):
                if arr[i]+arr[j]==target:
                    return "YES"
        return "NO"
#OR
#return [i, j]
        # No such pair found
        #return [-1, -1]
if __name__ == "__main__":
    sol = Solution()

    arr = [2, 6, 5, 8, 11]
    target = 14
    print(sol.twoSum(arr, target))